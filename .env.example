# Скопируй в .env и заполни:   cp .env.example .env
# .env НИКОГДА не коммить в git (он в .gitignore).

# --- Ozon Seller API (seller.ozon.ru → Настройки → Seller API) ---
OZON_CLIENT_ID=
OZON_API_KEY=

# --- PostgreSQL (используют и Docker Compose, и Python-скрипты) ---
# Пароль: только латинские буквы и цифры — он подставляется в URL
# подключения Airflow, и символы вроде @ : / # % его сломают.
PG_HOST=localhost
PG_PORT=5432
PG_DB=ozon_dwh
PG_USER=
PG_PASSWORD=
